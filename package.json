{
  "name": "excel-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Complemento de Excel con un agente (Claude) que ejecuta requerimientos sobre el libro abierto.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "certs": "office-addin-dev-certs install",
    "validate": "office-addin-manifest validate manifest.xml && office-addin-manifest validate manifest.dev.xml",
    "iconos": "node scripts/generar-iconos.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.611",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
